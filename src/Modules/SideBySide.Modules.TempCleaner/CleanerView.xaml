<UserControl x:Class="SideBySide.Modules.TempCleaner.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="urn:sidebyside-modules"
             xmlns:local="clr-namespace:SideBySide.Modules.TempCleaner"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:CleanerViewModel}">
  <m:ToolPanel Glyph="{x:Static m:Glyphs.Cleaner}" Title="{m:T '임시 파일 정리'}" Subtitle="{Binding SelectedSummary}"
               IsBusy="{Binding IsBusy}" Progress="{Binding Progress}" Status="{Binding Status}" ScrollContent="False">
    <m:ToolPanel.Footer>
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Button.Standard}" Content="{m:T '취소'}" Margin="0,0,8,0" Command="{Binding CancelWorkCommand}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        <Button Style="{StaticResource Button.Standard}" Content="{m:T '검사'}" Margin="0,0,8,0" MinWidth="72" Command="{Binding ScanCommand}" />
        <Button Style="{StaticResource Button.Primary}" Content="{m:T '정리'}" MinWidth="96" Command="{Binding CleanCommand}" />
      </StackPanel>
    </m:ToolPanel.Footer>

    <Grid Margin="0,0,0,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <m:ToolSection Header="{m:T '조건'}">
        <m:ToolRow Label="{m:T '며칠 이상 지난 파일만'}" Hint="{m:T '0이면 모든 파일. 최근 작업 중인 임시 파일을 남기려면 1~7일을 권장합니다.'}">
          <StackPanel Orientation="Horizontal">
            <TextBox Width="56" Text="{Binding MinAgeDays, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Text="{m:T '일'}" Margin="6,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </m:ToolRow>
      </m:ToolSection>

      <!-- 카테고리 -->
      <Border Grid.Row="1" Background="{DynamicResource Brush.WindowBg}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
              CornerRadius="{StaticResource Radius.Card}" ClipToBounds="True">
        <ListBox Style="{StaticResource ListBox.Plain}" ItemsSource="{Binding Categories}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Text.SectionHeader}" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type local:CategoryViewModel}">
              <Grid Margin="8,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Glyph}" Text="{x:Static m:Glyphs.Shield}" FontSize="11" Margin="6,0,0,0"
                               Foreground="{DynamicResource Brush.TextSecondary}" ToolTip="{m:T '관리자 권한 필요'}"
                               Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>
                  <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Secondary}" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Button.SmallIcon}" Content="&#xE8FD;" ToolTip="{m:T '파일 목록'}"
                        Command="{Binding DataContext.ShowFilesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                <Button Grid.Column="3" Style="{StaticResource Button.SmallIcon}" Content="{x:Static m:Glyphs.OpenFolder}" ToolTip="{m:T '폴더 열기'}"
                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- 카테고리 파일 목록 -->
      <m:ToolSection Grid.Row="2" Margin="0,12,0,0" Header="{Binding ListedCategory.Name}"
                     Visibility="{Binding HasFileList, Converter={StaticResource BoolToVis}}">
        <DockPanel Height="240">
          <DockPanel DockPanel.Dock="Bottom" Margin="8,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="{m:T '닫기'}" Command="{Binding CloseFilesCommand}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="{m:T '선택한 파일 삭제'}" Click="OnDeleteSelected" />
            <TextBlock />
          </DockPanel>
          <ListView x:Name="FileList" Style="{StaticResource ListView.Files}" ItemsSource="{Binding Files}" SelectionMode="Extended"
                    BorderThickness="0" Background="Transparent"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="{m:T '파일'}" Width="200">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="{m:T '크기'}" Width="80" DisplayMemberBinding="{Binding Size, Converter={x:Static local:CleanerView.SizeConverter}}" />
                <GridViewColumn Header="{m:T '수정한 날짜'}" Width="120" DisplayMemberBinding="{Binding Modified, StringFormat=g}" />
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </m:ToolSection>
    </Grid>
  </m:ToolPanel>
</UserControl>
