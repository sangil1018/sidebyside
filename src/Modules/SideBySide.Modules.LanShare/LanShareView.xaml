<UserControl x:Class="SideBySide.Modules.LanShare.LanShareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="urn:sidebyside-modules"
             xmlns:local="clr-namespace:SideBySide.Modules.LanShare"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:LanShareViewModel}">
  <m:ToolPanel Glyph="{x:Static m:Glyphs.LanShare}" Title="{m:T 'LAN 직접 연결 공유'}" Subtitle="{Binding MyIp}"
               IsBusy="{Binding IsBusy}" Status="{Binding Status}">
    <m:ToolPanel.HeaderTools>
      <Button Style="{StaticResource Button.Icon}" Content="{x:Static m:Glyphs.Refresh}" Command="{Binding RefreshAdaptersCommand}" ToolTip="{m:T '어댑터 다시 찾기'}" />
    </m:ToolPanel.HeaderTools>
    <m:ToolPanel.Footer>
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Button.Standard}" Margin="0,0,8,0" Command="{Binding ResetCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="{x:Static m:Glyphs.Shield}" FontSize="12" Margin="{StaticResource Icon.Gap}" />
            <TextBlock Text="{m:T '해제'}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource Button.Primary}" MinWidth="96" Command="{Binding ApplyCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="{x:Static m:Glyphs.Shield}" FontSize="12" Margin="{StaticResource Icon.Gap}" />
            <TextBlock Text="{m:T '적용'}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </m:ToolPanel.Footer>

    <StackPanel>
      <Border Background="{DynamicResource Brush.AccentSubtle}" CornerRadius="{StaticResource Radius.Card}" Padding="12,10" Margin="{StaticResource Section.Margin}">
        <TextBlock Text="{Binding StateText}" TextWrapping="Wrap" />
      </Border>

      <m:ToolSection Header="{m:T '연결'}">
        <StackPanel>
          <m:ToolRow Label="{m:T '유선 어댑터'}">
            <ComboBox Width="220" ItemsSource="{Binding Adapters}" SelectedItem="{Binding Adapter}" />
          </m:ToolRow>
          <m:ToolRow Label="{m:T '이 PC의 역할'}" Hint="{m:T '두 PC를 서로 다른 역할로 설정하세요. 상대 PC는 SideBySide나 LAN 공유 설정 도구 어느 쪽으로 설정해도 됩니다.'}">
            <StackPanel Orientation="Horizontal">
              <RadioButton GroupName="LanRole" Content="PC1 (192.168.1.1)" IsChecked="{Binding IsPc1}" Margin="0,0,12,0" />
              <RadioButton GroupName="LanRole" Content="PC2 (192.168.1.2)" IsChecked="{Binding IsPc2}" />
            </StackPanel>
          </m:ToolRow>
        </StackPanel>
      </m:ToolSection>

      <m:ToolSection Header="{m:T '공유 폴더'}">
        <StackPanel Margin="12,6">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Standard}" Content="{m:T '찾아보기…'}" Margin="8,0,0,0" Command="{Binding BrowseFolderCommand}" />
            <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" />
          </DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <RadioButton GroupName="LanPermission" Content="{m:T '읽기/쓰기'}" IsChecked="{Binding IsReadWrite}" Margin="0,0,12,0" />
            <RadioButton GroupName="LanPermission" Content="{m:T '읽기 전용'}" IsChecked="{Binding IsReadOnly}" />
          </StackPanel>
          <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="{m:T '같은 네트워크의 모든 사용자(Everyone)가 접근할 수 있습니다. 보안을 위해 권한 변경(모든 권한)은 허용하지 않습니다. 이미 LAN_Share 공유가 있으면 그대로 둡니다.'}" />
        </StackPanel>
      </m:ToolSection>

      <m:ToolSection Header="{m:T '상대 PC'}">
        <WrapPanel Margin="10,4">
          <Button Style="{StaticResource Button.Ghost}" Command="{Binding OpenPeerCommand}" ToolTip="{Binding PeerPath}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="{x:Static m:Glyphs.OpenFolder}" Margin="{StaticResource Icon.Gap}" />
              <TextBlock Text="{m:T '상대 PC 공유 열기'}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Ghost}" Command="{Binding PingPeerCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="{x:Static m:Glyphs.Network}" Margin="{StaticResource Icon.Gap}" />
              <TextBlock Text="{m:T '연결 확인'}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Button.Ghost}" Command="{Binding OpenShareFolderCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="{x:Static m:Glyphs.Folder}" Margin="{StaticResource Icon.Gap}" />
              <TextBlock Text="{m:T '내 공유 폴더 열기'}" />
            </StackPanel>
          </Button>
        </WrapPanel>
      </m:ToolSection>

      <m:ToolSection Header="{m:T '실행 기록'}" Visibility="{Binding HasLog, Converter={StaticResource BoolToVis}}">
        <ItemsControl ItemsSource="{Binding Log}" Margin="12,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:LogLine}">
              <DockPanel Margin="0,3" ToolTip="{Binding Detail}">
                <TextBlock x:Name="Mark" DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{x:Static m:Glyphs.Check}" FontSize="12"
                           Foreground="{DynamicResource Brush.DiffRightMark}" Margin="0,0,8,0" VerticalAlignment="Top" />
                <StackPanel>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                  <TextBlock x:Name="DetailText" Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
              </DockPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Ok}" Value="False">
                  <Setter TargetName="Mark" Property="Text" Value="{x:Static m:Glyphs.Warning}" />
                  <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Brush.DiffError}" />
                  <Setter TargetName="DetailText" Property="Visibility" Value="Visible" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </m:ToolSection>
    </StackPanel>
  </m:ToolPanel>
</UserControl>
