<UserControl x:Class="SideBySide.Modules.Git.GitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="urn:sidebyside-modules"
             xmlns:local="clr-namespace:SideBySide.Modules.Git"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:GitViewModel}"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
  <UserControl.Resources>
    <!-- diff 한 줄: 이전 줄 번호 · 새 줄 번호 · 내용 -->
    <DataTemplate x:Key="DiffLineTemplate" DataType="{x:Type local:DiffLine}">
      <Grid x:Name="Row" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="38" />
          <ColumnDefinition Width="38" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding OldNumberText}" TextAlignment="Right" Margin="0,0,6,0" FontFamily="{StaticResource Font.Mono}"
                   FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.TextDisabled}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding NewNumberText}" TextAlignment="Right" Margin="0,0,6,0" FontFamily="{StaticResource Font.Mono}"
                   FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.TextDisabled}" VerticalAlignment="Center" />
        <TextBlock x:Name="Body" Grid.Column="2" Text="{Binding Text}" FontFamily="{StaticResource Font.Mono}" Margin="6,1,10,1" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:DiffLineKind.Added}">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.DiffRight}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:DiffLineKind.Removed}">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.DiffRemoved}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:DiffLineKind.Hunk}">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
          <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:DiffLineKind.Note}">
          <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
          <Setter TargetName="Body" Property="FontStyle" Value="Italic" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="DiffList" TargetType="ListBox" BasedOn="{StaticResource ListBox.Plain}">
      <Setter Property="ItemContainerStyle" Value="{StaticResource ListBoxItem.DiffLine}" />
      <Setter Property="ItemTemplate" Value="{StaticResource DiffLineTemplate}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <!-- 변경 파일 한 줄의 상태 글자 (M/A/D/R/?/!) -->
    <Style x:Key="KindMark" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="8,0,2,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.DiffChangedMark}" />
      <Setter Property="Text" Value="{Binding KindText}" />
      <Setter Property="ToolTip" Value="{Binding KindTip}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding KindText}" Value="A">
          <Setter Property="Foreground" Value="{DynamicResource Brush.DiffRightMark}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding KindText}" Value="?">
          <Setter Property="Foreground" Value="{DynamicResource Brush.DiffRightMark}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding KindText}" Value="D">
          <Setter Property="Foreground" Value="{DynamicResource Brush.DiffError}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding KindText}" Value="!">
          <Setter Property="Foreground" Value="{DynamicResource Brush.DiffError}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.WindowBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
  </UserControl.Resources>

  <m:ToolPanel Glyph="{x:Static m:Glyphs.Git}" Title="Git" Subtitle="{Binding Subtitle}"
               IsBusy="{Binding IsBusy}" Status="{Binding Status}" ScrollContent="False">
    <m:ToolPanel.HeaderTools>
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Button.Icon}" Content="{x:Static m:Glyphs.Refresh}" Command="{Binding RefreshAllCommand}"
                ToolTip="{m:T '새로 고침 (원격 확인 포함)'}" />
        <ToggleButton x:Name="OptionsButton" Style="{StaticResource Button.Icon}" Content="{x:Static m:Glyphs.Settings}" ToolTip="{m:T 'Git 패널 옵션'}" />
        <Popup PlacementTarget="{Binding ElementName=OptionsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               IsOpen="{Binding IsChecked, ElementName=OptionsButton}">
          <Border Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                  CornerRadius="6" Padding="14,12" Margin="0,4,0,0" Width="280">
            <StackPanel>
              <CheckBox Content="{m:T '저장소 폴더에서 자동으로 열기'}" IsChecked="{Binding AutoOpen}" />
              <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                         Text="{m:T '한 창 모드에서 git 저장소 폴더에 들어가면 이 패널이 열리고, 저장소 밖으로 나가면 닫힙니다.'}" />
            </StackPanel>
          </Border>
        </Popup>
      </StackPanel>
    </m:ToolPanel.HeaderTools>
    <m:ToolPanel.Footer>
      <Button Style="{StaticResource Button.Primary}" MinWidth="120" Content="{Binding CommitText}" Command="{Binding CommitCommand}"
              IsEnabled="{Binding CanCommit}" Visibility="{Binding IsChanges, Converter={StaticResource BoolToVis}}" />
    </m:ToolPanel.Footer>

    <Grid>
      <!-- 저장소가 아니거나 git이 없을 때 -->
      <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.DiffChanged}" Padding="12,10" VerticalAlignment="Top"
              Visibility="{Binding Problem, Converter={StaticResource NullToVis}}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{x:Static m:Glyphs.Warning}"
                     Foreground="{DynamicResource Brush.DiffChangedMark}" VerticalAlignment="Top" Margin="0,1,8,0" />
          <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" />
        </DockPanel>
      </Border>

      <Grid Visibility="{Binding Problem, Converter={StaticResource NullToVisInv}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── 브랜치 · 동기화 ─────────────────────────────────────── -->
        <Grid Margin="0,0,0,8" IsEnabled="{Binding IsIdle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ToggleButton x:Name="BranchButton" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                        IsChecked="{Binding IsBranchPopupOpen}" ToolTip="{m:T '브랜치 전환 / 새 브랜치'}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="{x:Static m:Glyphs.Branch}" Margin="{StaticResource Icon.Gap}" />
              <TextBlock Text="{Binding BranchText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="180" />
              <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource Icon.Dropdown}" FontSize="9" Margin="6,0,0,0" />
            </StackPanel>
          </ToggleButton>
          <Popup PlacementTarget="{Binding ElementName=BranchButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                 IsOpen="{Binding IsBranchPopupOpen}">
            <Border Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                    CornerRadius="6" Padding="6" Margin="0,4,0,0" Width="280">
              <StackPanel>
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                  <ItemsControl ItemsSource="{Binding Branches}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:GitBranch}">
                        <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                CommandParameter="{Binding}"
                                Command="{Binding DataContext.CheckoutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                          <DockPanel Width="244">
                            <TextBlock DockPanel.Dock="Left" Width="18" Style="{StaticResource Glyph}" Text="{x:Static m:Glyphs.Check}" FontSize="11"
                                       Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Secondary}" Text="{m:T '원격'}" Margin="8,0,0,0"
                                       Visibility="{Binding IsRemote, Converter={StaticResource BoolToVis}}" />
                            <TextBlock x:Name="Name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="18,0,0,0" />
                          </DockPanel>
                        </Button>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="Name" Property="Margin" Value="0" />
                            <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <Rectangle Height="1" Margin="0,6" Fill="{DynamicResource Brush.Border}" />
                <DockPanel Margin="4,0,4,2">
                  <Button DockPanel.Dock="Right" Style="{StaticResource Button.Standard}" Content="{m:T '새 브랜치'}" Margin="6,0,0,0"
                          Command="{Binding CreateBranchCommand}" />
                  <Grid>
                    <TextBox Text="{Binding NewBranchName, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnNewBranchKeyDown" />
                    <TextBlock Text="{m:T '새 브랜치 이름'}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource Brush.TextDisabled}"
                               Visibility="{Binding NewBranchName, Converter={StaticResource NullToVisInv}}" />
                  </Grid>
                </DockPanel>
              </StackPanel>
            </Border>
          </Popup>

          <Button Grid.Column="1" Style="{StaticResource Button.Standard}" Command="{Binding SyncCommand}" ToolTip="{Binding SyncTip}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="{x:Static m:Glyphs.Sync}" FontSize="12" Margin="{StaticResource Icon.Gap}" />
              <TextBlock Text="{Binding SyncText}" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- ── 변경 | 기록 ─────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Hover}" CornerRadius="5" Padding="2" HorizontalAlignment="Left" Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource Radio.Segment}" Content="{m:T '변경'}" GroupName="GitTabs"
                         IsChecked="{Binding IsHistory, Converter={StaticResource InverseBool}}" />
            <RadioButton Style="{StaticResource Radio.Segment}" Content="{m:T '기록'}" GroupName="GitTabs" IsChecked="{Binding IsHistory}" />
          </StackPanel>
        </Border>

        <!-- ── 변경 탭 ─────────────────────────────────────────────── -->
        <Grid Grid.Row="2" Visibility="{Binding IsChanges, Converter={StaticResource BoolToVis}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="70" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="70" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Margin="2,0,0,6">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.SmallIcon}" Content="{x:Static m:Glyphs.Undo}"
                    Command="{Binding DiscardAllCommand}" IsEnabled="{Binding IsIdle}" ToolTip="{m:T '모든 변경 취소…'}" />
            <CheckBox IsChecked="{Binding AllChecked}" VerticalAlignment="Center" Margin="12,0,8,0" ToolTip="{m:T '모두 선택 / 해제'}" />
            <TextBlock Text="{Binding ChangesTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>

          <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
              <ListBox Style="{StaticResource ListBox.Plain}" ItemsSource="{Binding Changes}" SelectedItem="{Binding SelectedChange}"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="2">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:ChangeItem}">
                    <Grid ToolTip="{Binding PathText}" Background="Transparent"
                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="{m:T '변경 취소…'}" CommandParameter="{Binding}"
                                    Command="{Binding PlacementTarget.Tag.DiscardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                          <MenuItem Header="{m:T '파일 목록에서 보기'}" CommandParameter="{Binding}"
                                    Command="{Binding PlacementTarget.Tag.RevealCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                      </Grid.ContextMenu>
                      <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <Run Text="{Binding FileName, Mode=OneWay}" /><Run Text="{Binding FolderText, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}" />
                      </TextBlock>
                      <TextBlock Grid.Column="2" Style="{StaticResource KindMark}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Style="{StaticResource Text.Secondary}" Text="{m:T '변경된 파일이 없습니다.'}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsHitTestVisible="False" Visibility="{Binding SelectedChange, Converter={StaticResource NullToVisInv}}" />
            </Grid>
          </Border>

          <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"
                        ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Focusable="False" />

          <Border Grid.Row="3" Style="{StaticResource Card}">
            <ListBox Style="{StaticResource DiffList}" ItemsSource="{Binding ChangeDiff}" />
          </Border>

          <!-- 커밋 메시지 -->
          <StackPanel Grid.Row="4" Margin="0,8,0,10" IsEnabled="{Binding IsIdle}">
            <Grid>
              <TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnSummaryKeyDown" />
              <TextBlock Text="{m:T '요약 (필수)'}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                         Foreground="{DynamicResource Brush.TextDisabled}"
                         Visibility="{Binding Summary, Converter={StaticResource NullToVisInv}}" />
            </Grid>
            <Grid Margin="0,6,0,0">
              <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                       MinHeight="52" MaxHeight="110" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
              <TextBlock Text="{m:T '설명'}" Margin="9,7,0,0" VerticalAlignment="Top" IsHitTestVisible="False"
                         Foreground="{DynamicResource Brush.TextDisabled}"
                         Visibility="{Binding Description, Converter={StaticResource NullToVisInv}}" />
            </Grid>
          </StackPanel>
        </Grid>

        <!-- ── 기록 탭 ─────────────────────────────────────────────── -->
        <Grid Grid.Row="2" Visibility="{Binding IsHistory, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="2*" MinHeight="70" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="120" />
          </Grid.RowDefinitions>

          <Border Style="{StaticResource Card}">
            <DockPanel>
              <Button DockPanel.Dock="Bottom" Style="{StaticResource Button.Ghost}" Content="{m:T '이전 기록 더 보기'}" HorizontalAlignment="Center"
                      Margin="0,2,0,4" Command="{Binding LoadMoreCommand}"
                      Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVis}}" />
              <Grid>
                <ListBox Style="{StaticResource ListBox.Plain}" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedCommit}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" Margin="2">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:CommitItem}">
                      <DockPanel ToolTip="{Binding Tip}" Background="Transparent">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Glyph}" Text="{x:Static m:Glyphs.Up}" FontSize="11" Margin="8,0,2,0"
                                   Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" ToolTip="{m:T '아직 원격에 올리지 않은 커밋'}"
                                   Visibility="{Binding IsUnpushed, Converter={StaticResource BoolToVis}}" />
                        <StackPanel>
                          <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Style="{StaticResource Text.Secondary}" Text="{m:T '커밋 기록이 없습니다.'}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Visibility="{Binding SelectedCommit, Converter={StaticResource NullToVisInv}}" />
              </Grid>
            </DockPanel>
          </Border>

          <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"
                        ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Focusable="False" />

          <!-- 고른 커밋의 변경 파일 + diff -->
          <DockPanel Grid.Row="2">
          <Border DockPanel.Dock="Top" Style="{StaticResource Card}" MaxHeight="120" Margin="0,0,0,8">
            <ListBox Style="{StaticResource ListBox.Plain}" ItemsSource="{Binding CommitFiles}" SelectedItem="{Binding SelectedCommitFile}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="2">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ChangeItem}">
                  <DockPanel ToolTip="{Binding PathText}" Background="Transparent">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource KindMark}" />
                    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                      <Run Text="{Binding FileName, Mode=OneWay}" /><Run Text="{Binding FolderText, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </TextBlock>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <Border Style="{StaticResource Card}">
            <ListBox Style="{StaticResource DiffList}" ItemsSource="{Binding HistoryDiff}" />
          </Border>
          </DockPanel>
        </Grid>
      </Grid>
    </Grid>
  </m:ToolPanel>
</UserControl>
