<UserControl x:Class="SideBySide.App.Views.FilePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SideBySide.App.ViewModels"
             xmlns:views="clr-namespace:SideBySide.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PaneViewModel}"
             PreviewMouseDown="OnAnyMouseDown"
             GotKeyboardFocus="OnAnyKeyboardFocus">
  <Grid Background="{DynamicResource Brush.SurfaceBg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="36" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ── 탭 표시줄 ───────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="{DynamicResource Brush.WindowBg}" Padding="6,0,0,0">
      <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Orientation="Horizontal">
          <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:TabViewModel}">
                <Border x:Name="TabBd" Height="30" Margin="0,6,2,0" Padding="12,0,4,0" CornerRadius="6,6,0,0"
                        Background="Transparent" MinWidth="110" MaxWidth="220" ToolTip="{Binding Path}"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                  <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}"
                                  Command="{Binding DataContext.ActivateTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <MouseBinding MouseAction="MiddleClick" CommandParameter="{Binding}"
                                  Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </Border.InputBindings>
                  <Border.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="탭 닫기" CommandParameter="{Binding}"
                                Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                      <MenuItem Header="다른 탭 모두 닫기" CommandParameter="{Binding}"
                                Command="{Binding PlacementTarget.Tag.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Grid>
                    <Rectangle x:Name="ActiveLine" Height="2" VerticalAlignment="Top" Margin="-8,0,0,0" RadiusX="1" RadiusY="1"
                               Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Style="{StaticResource Button.SmallIcon}" Content="&#xE711;" Opacity="0.7"
                              ToolTip="탭 닫기 (Ctrl+W)" CommandParameter="{Binding}"
                              Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                      <TextBlock x:Name="TabTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                 Margin="0,0,6,0" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </DockPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <Trigger SourceName="TabBd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                  </Trigger>
                  <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource Brush.SurfaceBg}" />
                    <Setter TargetName="TabTitle" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                  </DataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsActive}" Value="True" />
                      <Condition Binding="{Binding DataContext.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible" />
                  </MultiDataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Style="{StaticResource Button.Icon}" Content="&#xE710;" FontSize="12" Height="28" Margin="2,6,0,0"
                  Command="{Binding AddTabCommand}" ToolTip="새 탭 (Ctrl+T)" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- ── 탐색 줄 ─────────────────────────────────────────────── -->
    <Grid Grid.Row="1" Margin="6,6,8,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource Button.Icon}" Content="&#xE72B;" Click="OnBack" ToolTip="뒤로 (Alt+←)"
                IsEnabled="{Binding ActiveTab.CanGoBack}" />
        <Button Style="{StaticResource Button.Icon}" Content="&#xE72A;" Click="OnForward" ToolTip="앞으로 (Alt+→)"
                IsEnabled="{Binding ActiveTab.CanGoForward}" />
        <Button Style="{StaticResource Button.Icon}" Content="&#xE74A;" Click="OnUp" ToolTip="상위 폴더 (Alt+↑)"
                IsEnabled="{Binding ActiveTab.CanGoUp}" />
        <Button Style="{StaticResource Button.Icon}" Content="&#xE72C;" Click="OnRefresh" ToolTip="새로 고침 (F5)" />
      </StackPanel>
      <views:AddressBar x:Name="Address" Grid.Column="1" Margin="4,0,6,0" DataContext="{Binding ActiveTab}" />
      <Grid Grid.Column="2" Width="190">
        <TextBox x:Name="SearchBox" Padding="26,4,6,4"
                 Text="{Binding ActiveTab.SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                 PreviewKeyDown="OnSearchKeyDown" />
        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="12" HorizontalAlignment="Left" Margin="9,0,0,0"
                   Foreground="{DynamicResource Brush.TextSecondary}" IsHitTestVisible="False" />
        <TextBlock Text="검색" Margin="27,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                   Foreground="{DynamicResource Brush.TextDisabled}"
                   Visibility="{Binding ActiveTab.SearchText, Converter={StaticResource NullToVisInv}}" />
      </Grid>
    </Grid>

    <!-- ── 파일 목록 ───────────────────────────────────────────── -->
    <Grid Grid.Row="2">
      <views:FileListView x:Name="List" Style="{StaticResource ListView.Files}"
                          ItemsSource="{Binding ActiveTab.Items}"
                          TextSearch.TextPath="Name"
                          AllowDrop="True"
                          SelectionChanged="OnSelectionChanged"
                          PreviewMouseLeftButtonDown="OnListMouseDown"
                          PreviewMouseLeftButtonUp="OnListMouseUp"
                          PreviewMouseMove="OnListMouseMove"
                          PreviewMouseRightButtonDown="OnListRightMouseDown"
                          MouseRightButtonUp="OnListRightMouseUp"
                          MouseDown="OnListMiddleMouseDown"
                          DragOver="OnDragOver"
                          DragEnter="OnDragOver"
                          Drop="OnDrop"
                          GridViewColumnHeader.Click="OnHeaderClick">
        <ListView.View>
          <GridView AllowsColumnReorder="False">
            <GridViewColumn Width="340">
              <GridViewColumn.Header>
                <GridViewColumnHeader Tag="Name">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="이름" />
                    <TextBlock x:Name="SortName" Style="{StaticResource Glyph}" FontSize="8" Margin="6,0,0,0" />
                  </StackPanel>
                </GridViewColumnHeader>
              </GridViewColumn.Header>
              <GridViewColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="2,0,8,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInv}}" />
                    <TextBox Grid.Column="1" Padding="3,1" Margin="-4,0,0,0"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                             IsVisibleChanged="OnRenameBoxVisibleChanged"
                             PreviewKeyDown="OnRenameKeyDown"
                             LostKeyboardFocus="OnRenameLostFocus" />
                    <Ellipse Grid.Column="2" Width="6" Height="6" Margin="6,0,0,0" Fill="{DynamicResource Brush.Newer}"
                             ToolTip="이쪽이 더 최신입니다" Visibility="{Binding IsNewer, Converter={StaticResource BoolToVis}}" />
                  </Grid>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="140">
              <GridViewColumn.Header>
                <GridViewColumnHeader Tag="Modified">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="수정한 날짜" />
                    <TextBlock x:Name="SortModified" Style="{StaticResource Glyph}" FontSize="8" Margin="6,0,0,0" />
                  </StackPanel>
                </GridViewColumnHeader>
              </GridViewColumn.Header>
              <GridViewColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                  <TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource Brush.TextSecondary}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="130">
              <GridViewColumn.Header>
                <GridViewColumnHeader Tag="Type">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="유형" />
                    <TextBlock x:Name="SortType" Style="{StaticResource Glyph}" FontSize="8" Margin="6,0,0,0" />
                  </StackPanel>
                </GridViewColumnHeader>
              </GridViewColumn.Header>
              <GridViewColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                  <TextBlock Text="{Binding TypeText}" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="100">
              <GridViewColumn.Header>
                <GridViewColumnHeader Tag="Size" HorizontalContentAlignment="Right">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SortSize" Style="{StaticResource Glyph}" FontSize="8" Margin="0,0,6,0" />
                    <TextBlock Text="크기" />
                  </StackPanel>
                </GridViewColumnHeader>
              </GridViewColumn.Header>
              <GridViewColumn.CellTemplate>
                <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                  <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextSecondary}" />
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </views:FileListView>

      <!-- 로딩 표시 (상단 얇은 선) -->
      <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource Brush.Accent}" Opacity="0.7" IsHitTestVisible="False"
                 Visibility="{Binding ActiveTab.IsLoading, Converter={StaticResource BoolToVis}}" />

      <TextBlock Text="{Binding ActiveTab.Error}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,64,24,0" TextAlignment="Center"
                 Visibility="{Binding ActiveTab.Error, Converter={StaticResource NullToVis}}" />

      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,64,0,0" IsHitTestVisible="False">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Text" Value="이 폴더는 비어 있습니다." />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding ActiveTab.Items.Count}" Value="0" />
                  <Condition Binding="{Binding ActiveTab.IsLoading}" Value="False" />
                  <Condition Binding="{Binding ActiveTab.Error}" Value="{x:Null}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
  </Grid>
</UserControl>
