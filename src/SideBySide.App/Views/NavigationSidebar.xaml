<UserControl x:Class="SideBySide.App.Views.NavigationSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SideBySide.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}">
  <UserControl.Resources>
    <DataTemplate x:Key="NavItem" DataType="{x:Type vm:SidebarItem}">
      <Grid Background="Transparent" ToolTip="{Binding Path}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{DynamicResource Brush.TextSecondary}"
                   Margin="0,0,10,0" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <!-- 드라이브 사용량 -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,4,0,1" Visibility="{Binding HasUsage, Converter={StaticResource BoolToVis}}">
          <Border x:Name="Track" Height="3" CornerRadius="1.5" Background="{DynamicResource Brush.Border}" />
          <Border Height="3" CornerRadius="1.5" HorizontalAlignment="Left" Background="{DynamicResource Brush.Accent}">
            <Border.Width>
              <MultiBinding Converter="{StaticResource RatioToWidth}">
                <Binding Path="Usage" />
                <Binding Path="ActualWidth" ElementName="Track" />
              </MultiBinding>
            </Border.Width>
          </Border>
        </Grid>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Border Background="{DynamicResource Brush.SidebarBg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Margin="0,4,0,12">
        <TextBlock Style="{StaticResource Text.SectionHeader}" Text="빠른 실행" />
        <ListBox Style="{StaticResource ListBox.Plain}" ItemsSource="{Binding Sidebar.QuickAccess}"
                 ItemTemplate="{StaticResource NavItem}" PreviewMouseUp="OnItemMouseUp" Focusable="False" />
        <TextBlock Style="{StaticResource Text.SectionHeader}" Text="내 PC" Cursor="Hand" MouseLeftButtonUp="OnThisPcClick" />
        <ListBox Style="{StaticResource ListBox.Plain}" ItemsSource="{Binding Sidebar.Drives}"
                 ItemTemplate="{StaticResource NavItem}" PreviewMouseUp="OnItemMouseUp" Focusable="False" />
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
