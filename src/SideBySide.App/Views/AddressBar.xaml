<UserControl x:Class="SideBySide.App.Views.AddressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="30">
  <!-- 경로 조각(브레드크럼). 빈 곳을 클릭하거나 Ctrl+L이면 텍스트 편집. -->
  <Border x:Name="Frame" Background="{DynamicResource Brush.InputBg}" BorderBrush="{DynamicResource Brush.BorderStrong}"
          BorderThickness="1" CornerRadius="{StaticResource Radius}" MouseLeftButtonDown="OnFrameMouseDown" Cursor="IBeam">
    <Grid>
      <ScrollViewer x:Name="CrumbScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                    Focusable="False" Cursor="Arrow" HorizontalAlignment="Left">
        <ItemsControl x:Name="Crumbs" Margin="2,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="9" Margin="2,0"
                           Foreground="{DynamicResource Brush.TextSecondary}" Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource Button.Ghost}" MinHeight="24" Padding="6,1" Content="{Binding Name}"
                        Click="OnCrumbClick" Tag="{Binding Path}" ToolTip="{Binding Path}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBox x:Name="Editor" Visibility="Collapsed" BorderThickness="0" Background="Transparent" Padding="6,0"
               PreviewKeyDown="OnEditorKeyDown" LostKeyboardFocus="OnEditorLostFocus" />
    </Grid>
  </Border>
</UserControl>
