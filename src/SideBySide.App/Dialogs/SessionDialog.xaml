<Window x:Class="SideBySide.App.Dialogs.SessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Dialog}" Title="비교 세션" Width="560">
  <StackPanel>
    <StackPanel Margin="20,18,20,20">
      <TextBlock Style="{StaticResource Dialog.Label}" Text="저장된 세션" />
      <ListBox x:Name="Sessions" Height="260" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
               Background="{DynamicResource Brush.SurfaceBg}" MouseDoubleClick="OnOpen"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItem.Nav}">
            <Setter Property="Margin" Value="4,2" />
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding LeftPath, Mode=OneWay}" />
                <Run Text="  ↔  " />
                <Run Text="{Binding RightPath, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyText" Style="{StaticResource Dialog.Hint}"
                 Text="저장된 세션이 없습니다. 비교 모드에서 Ctrl+Shift+S로 현재 폴더 쌍을 저장하세요." />
    </StackPanel>
    <Border Style="{StaticResource Dialog.Footer}">
      <DockPanel>
        <Button DockPanel.Dock="Left" Style="{StaticResource Button.Standard}" Content="삭제" Click="OnDelete" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource Button.Standard}" Content="취소" IsCancel="True" Margin="0,0,8,0" />
          <Button Style="{StaticResource Button.Primary}" Content="열기" IsDefault="True" Click="OnOpen" />
        </StackPanel>
      </DockPanel>
    </Border>
  </StackPanel>
</Window>
