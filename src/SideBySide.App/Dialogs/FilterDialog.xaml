<Window x:Class="SideBySide.App.Dialogs.FilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SideBySide.App.Infrastructure"
        Style="{StaticResource Window.Dialog}" Title="{l:T '필터'}" Width="540">
  <StackPanel>
    <StackPanel Margin="20,18,20,20">
      <TextBlock Style="{StaticResource Dialog.Label}" Text="{l:T '프리셋'}" />
      <DockPanel Margin="0,0,0,16">
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Standard}" Content="{l:T '삭제'}" MinWidth="60" Margin="8,0,0,0" Click="OnDeletePreset" />
        <ComboBox x:Name="Presets" DisplayMemberPath="Name" SelectionChanged="OnPresetSelected" />
      </DockPanel>

      <TextBlock Style="{StaticResource Dialog.Label}" Text="{l:T '숨길 항목 (제외)'}" />
      <TextBox x:Name="ExcludeBox" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
               FontFamily="{StaticResource Font.Mono}" />
      <TextBlock Style="{StaticResource Dialog.Hint}"
                 Text="{l:T '; 또는 줄바꿈으로 구분. * ? 와일드카드 사용. 끝에 \\ 를 붙이면 폴더에만 적용  (예: *.tmp; *.log; bin\\; .git\\)'}" />

      <TextBlock Style="{StaticResource Dialog.Label}" Text="{l:T '이 파일만 표시 (포함)'}" Margin="0,16,0,6" />
      <TextBox x:Name="IncludeBox" Height="44" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
               FontFamily="{StaticResource Font.Mono}" />
      <TextBlock Style="{StaticResource Dialog.Hint}" Text="{l:T '비워 두면 모든 파일 표시. 폴더는 항상 표시됩니다.  (예: *.cs; *.xaml)'}" />

      <TextBlock Style="{StaticResource Dialog.Label}" Text="{l:T '프리셋으로 저장 (선택)'}" Margin="0,16,0,6" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Standard}" Content="{l:T '저장'}" MinWidth="60" Margin="8,0,0,0" Click="OnSavePreset" />
        <TextBox x:Name="NameBox" />
      </DockPanel>
    </StackPanel>
    <Border Style="{StaticResource Dialog.Footer}">
      <DockPanel>
        <Button DockPanel.Dock="Left" Style="{StaticResource Button.Standard}" Content="{l:T '필터 해제'}" Click="OnClear" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource Button.Standard}" Content="{l:T '취소'}" IsCancel="True" Margin="0,0,8,0" />
          <Button Style="{StaticResource Button.Primary}" Content="{l:T '적용'}" IsDefault="True" Click="OnApply" />
        </StackPanel>
      </DockPanel>
    </Border>
  </StackPanel>
</Window>
