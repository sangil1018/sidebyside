<Window x:Class="SideBySide.App.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SideBySide.App.Infrastructure"
        Style="{StaticResource Window.Dialog}" Title="{l:T '환경설정'}" Width="640">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Dialog.Footer}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource Button.Standard}" Content="{l:T '취소'}" IsCancel="True" Margin="0,0,8,0" />
        <Button Style="{StaticResource Button.Primary}" Content="{l:T '확인'}" IsDefault="True" Click="OnOk" />
      </StackPanel>
    </Border>

    <!-- 탭: 일반 / 탐색 창 / 단축키 -->
    <Border DockPanel.Dock="Top" Margin="20,16,20,0" HorizontalAlignment="Left"
            Background="{DynamicResource Brush.Hover}" CornerRadius="5" Padding="2">
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="TabGeneral" Style="{StaticResource Radio.Segment}" Content="{l:T '일반'}" GroupName="Tabs" IsChecked="True" Checked="OnTabChanged" />
        <RadioButton x:Name="TabSidebar" Style="{StaticResource Radio.Segment}" Content="{l:T '탐색 창'}" GroupName="Tabs" Checked="OnTabChanged" />
        <RadioButton x:Name="TabShortcuts" Style="{StaticResource Radio.Segment}" Content="{l:T '단축키'}" GroupName="Tabs" Checked="OnTabChanged" />
      </StackPanel>
    </Border>

    <Grid Margin="20,16,20,20" Height="460">
      <!-- 일반 -->
      <ScrollViewer x:Name="GeneralPage" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource Dialog.Label}" Text="{l:T '테마'}" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <RadioButton x:Name="ThemeSystem" Content="{l:T '시스템'}" GroupName="Theme" Margin="0,0,18,0" />
            <RadioButton x:Name="ThemeLight" Content="{l:T '라이트'}" GroupName="Theme" Margin="0,0,18,0" />
            <RadioButton x:Name="ThemeDark" Content="{l:T '다크'}" GroupName="Theme" />
          </StackPanel>

          <TextBlock Style="{StaticResource Dialog.Label}" Text="{l:T '언어 (Language)'}" />
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="LanguageKorean" Content="{l:T '한국어'}" GroupName="Language" Margin="0,0,18,0" />
            <RadioButton x:Name="LanguageEnglish" Content="English" GroupName="Language" />
          </StackPanel>
          <TextBlock Style="{StaticResource Dialog.Hint}" Margin="0,4,0,18" TextWrapping="Wrap"
                     Text="{l:T '다시 시작하면 적용됩니다. (Applies after restart.)'}" />

          <TextBlock Style="{StaticResource Dialog.Label}" Text="{l:T '파일 관리자'}" />
          <CheckBox x:Name="DefaultManager" Content="{l:T '기본 파일 관리자로 사용'}" />
          <TextBlock Style="{StaticResource Dialog.Hint}" Margin="22,6,0,18" TextWrapping="Wrap"
                     Text="{l:T '다른 프로그램이 폴더를 열 때와 탐색기 우클릭 &quot;새 창에서 열기&quot;를 SideBySide로 엽니다. 끄면 원래 설정(Windows 탐색기)으로 되돌립니다. Win+E와 작업 표시줄의 탐색기 아이콘은 그대로 탐색기를 엽니다.'}" />

          <TextBlock Style="{StaticResource Dialog.Label}" Text="{l:T '창 열기 단축키'}" />
          <StackPanel>
            <RadioButton x:Name="ShortcutWinAltE" Content="Win + Alt + E" GroupName="Shortcut" Margin="0,0,0,8" />
            <RadioButton x:Name="ShortcutWinCtrlE" Content="Win + Ctrl + E" GroupName="Shortcut" Margin="0,0,0,8" />
            <RadioButton x:Name="ShortcutWinShiftE" Content="Win + Shift + E" GroupName="Shortcut" />
          </StackPanel>
          <CheckBox x:Name="ShortcutWhenClosed" Content="{l:T 'SideBySide가 꺼져 있어도 단축키 사용'}" Margin="0,12,0,0" />
          <TextBlock Style="{StaticResource Dialog.Hint}" Margin="22,4,0,0" TextWrapping="Wrap"
                     Text="{l:T 'Windows에 로그인하면 창 없이 백그라운드로 대기하다가, 단축키를 누르면 SideBySide를 열거나 열려 있는 창을 앞으로 가져옵니다. 끄면 앱이 실행 중일 때만 동작합니다.'}" />
          <TextBlock Style="{StaticResource Dialog.Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="{l:T '다른 프로그램이 같은 키를 쓰면 등록되지 않습니다.'}" />
        </StackPanel>
      </ScrollViewer>

      <!-- 탐색 창 -->
      <StackPanel x:Name="SidebarPage" Visibility="Collapsed">
        <TextBlock Style="{StaticResource Dialog.Label}" Text="{l:T '빠른 실행에 표시'}" />
        <StackPanel x:Name="SystemPlacesPanel" />
        <TextBlock Style="{StaticResource Dialog.Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="{l:T '이 위치들은 Windows 탐색기(또는 Windows 설정)로 엽니다.'}" />
      </StackPanel>

      <!-- 단축키 -->
      <DockPanel x:Name="ShortcutsPage" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <TextBlock Style="{StaticResource Dialog.Label}" Text="{l:T '선택한 명령의 새 단축키'}" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Standard}" Content="{l:T '모두 기본값'}" Margin="8,0,0,0" Click="OnResetAll" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Standard}" Content="{l:T '기본값'}" Margin="8,0,0,0" Click="OnResetOne" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Standard}" Content="{l:T '없음'}" Margin="8,0,0,0" Click="OnClearOne" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Standard}" Content="{l:T '지정'}" Margin="8,0,0,0" Click="OnAssign" />
            <TextBox x:Name="CaptureBox" IsReadOnly="True" PreviewKeyDown="OnCaptureKeyDown" />
          </DockPanel>
          <TextBlock x:Name="ShortcutHint" Style="{StaticResource Dialog.Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="{l:T '목록에서 명령을 고르고 입력란을 누른 뒤 원하는 키 조합을 누르세요. 바꾼 단축키는 확인을 누르면 바로 적용됩니다 (버튼 도움말의 표시는 다시 시작하면 바뀝니다).'}" />
        </StackPanel>
        <ListView x:Name="ShortcutList" Style="{StaticResource ListView.Files}" SelectionMode="Single"
                  SelectionChanged="OnShortcutSelected" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="{l:T '명령'}" Width="300" DisplayMemberBinding="{Binding Title}" />
              <GridViewColumn Header="{l:T '단축키'}" Width="170" DisplayMemberBinding="{Binding Gesture}" />
              <GridViewColumn Header="{l:T '범위'}" Width="100" DisplayMemberBinding="{Binding ScopeText}" />
            </GridView>
          </ListView.View>
        </ListView>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
