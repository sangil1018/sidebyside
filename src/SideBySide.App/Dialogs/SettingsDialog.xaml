<Window x:Class="SideBySide.App.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Dialog}" Title="환경설정" Width="480">
  <StackPanel>
    <StackPanel Margin="20,18,20,20">
      <TextBlock Style="{StaticResource Dialog.Label}" Text="테마" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
        <RadioButton x:Name="ThemeSystem" Content="시스템" GroupName="Theme" Margin="0,0,18,0" />
        <RadioButton x:Name="ThemeLight" Content="라이트" GroupName="Theme" Margin="0,0,18,0" />
        <RadioButton x:Name="ThemeDark" Content="다크" GroupName="Theme" />
      </StackPanel>

      <TextBlock Style="{StaticResource Dialog.Label}" Text="파일 관리자" />
      <CheckBox x:Name="DefaultManager" Content="기본 파일 관리자로 사용" />
      <TextBlock Style="{StaticResource Dialog.Hint}" Margin="22,6,0,0" TextWrapping="Wrap"
                 Text="다른 프로그램이 폴더를 열 때와 탐색기 우클릭 &quot;새 창에서 열기&quot;를 SideBySide로 엽니다. 끄면 원래 설정(Windows 탐색기)으로 되돌립니다. Win+E와 작업 표시줄의 탐색기 아이콘은 그대로 탐색기를 엽니다." />

      <TextBlock Style="{StaticResource Dialog.Label}" Text="창 열기 단축키" Margin="0,20,0,8" />
      <StackPanel>
        <RadioButton x:Name="ShortcutWinAltE" Content="Win + Alt + E" GroupName="Shortcut" Margin="0,0,0,8" />
        <RadioButton x:Name="ShortcutWinCtrlE" Content="Win + Ctrl + E" GroupName="Shortcut" Margin="0,0,0,8" />
        <RadioButton x:Name="ShortcutWinShiftE" Content="Win + Shift + E" GroupName="Shortcut" />
      </StackPanel>
      <CheckBox x:Name="ShortcutWhenClosed" Content="SideBySide가 꺼져 있어도 단축키 사용" Margin="0,12,0,0" />
      <TextBlock Style="{StaticResource Dialog.Hint}" Margin="22,4,0,0" TextWrapping="Wrap"
                 Text="Windows에 로그인하면 창 없이 백그라운드로 대기하다가, 단축키를 누르면 SideBySide를 열거나 열려 있는 창을 앞으로 가져옵니다. 끄면 앱이 실행 중일 때만 동작합니다." />
      <TextBlock Style="{StaticResource Dialog.Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                 Text="다른 프로그램이 같은 키를 쓰면 등록되지 않습니다." />
    </StackPanel>
    <Border Style="{StaticResource Dialog.Footer}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource Button.Standard}" Content="취소" IsCancel="True" Margin="0,0,8,0" />
        <Button Style="{StaticResource Button.Primary}" Content="확인" IsDefault="True" Click="OnOk" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
