<Window x:Class="SideBySide.App.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SideBySide.App.Infrastructure"
        Style="{StaticResource Window.Dialog}" Title="{l:T '환경설정'}" Width="800">
  <Window.Resources>
    <!-- 왼쪽 탐색 목록 항목 -->
    <Style x:Key="Settings.Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Radius}" Padding="12,8">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
              <Rectangle x:Name="Bar" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left"
                         Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selected}" />
                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Settings.PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="Settings.Section" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,16,0,8" />
    </Style>

    <!-- 설정 묶음 카드: 행 사이에 얇은 선 -->
    <Style x:Key="Settings.Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.SurfaceBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="Settings.Row" TargetType="Grid">
      <Setter Property="Margin" Value="16,12" />
      <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style x:Key="Settings.Divider" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
    </Style>

    <Style x:Key="Settings.RowTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>

    <Style x:Key="Settings.RowHint" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    </Style>

    <Style x:Key="Settings.Segment" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Dialog.Footer}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource Button.Standard}" Content="{l:T '취소'}" IsCancel="True" Margin="0,0,8,0" />
        <Button Style="{StaticResource Button.Primary}" Content="{l:T '확인'}" IsDefault="True" Click="OnOk" />
      </StackPanel>
    </Border>

    <Grid Height="560">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 왼쪽: 페이지 목록 -->
      <Border Background="{DynamicResource Brush.SidebarBg}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" Padding="10,16">
        <StackPanel>
          <RadioButton x:Name="TabGeneral" Style="{StaticResource Settings.Nav}" GroupName="Pages" IsChecked="True" Checked="OnTabChanged">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Margin="0,0,12,0" />
              <TextBlock Text="{l:T '일반'}" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="TabSidebar" Style="{StaticResource Settings.Nav}" GroupName="Pages" Checked="OnTabChanged">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A0;" Margin="0,0,12,0" />
              <TextBlock Text="{l:T '탐색 창'}" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="TabShortcuts" Style="{StaticResource Settings.Nav}" GroupName="Pages" Checked="OnTabChanged">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE765;" Margin="0,0,12,0" />
              <TextBlock Text="{l:T '단축키'}" />
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </Border>

      <!-- 오른쪽: 페이지 -->
      <Grid Grid.Column="1" Margin="24,18,24,16">

        <!-- 일반 -->
        <ScrollViewer x:Name="GeneralPage" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Settings.PageTitle}" Text="{l:T '일반'}" />

            <TextBlock Style="{StaticResource Settings.Section}" Text="{l:T '모양'}" Margin="2,0,0,8" />
            <Border Style="{StaticResource Settings.Card}">
              <StackPanel>
                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Settings.RowTitle}" Text="{l:T '테마'}" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Style="{StaticResource Settings.Segment}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="ThemeSystem" Style="{StaticResource Radio.Segment}" Content="{l:T '시스템'}" GroupName="Theme" />
                      <RadioButton x:Name="ThemeLight" Style="{StaticResource Radio.Segment}" Content="{l:T '라이트'}" GroupName="Theme" />
                      <RadioButton x:Name="ThemeDark" Style="{StaticResource Radio.Segment}" Content="{l:T '다크'}" GroupName="Theme" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Border Style="{StaticResource Settings.Divider}" />
                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Settings.RowTitle}" Text="{l:T '언어 (Language)'}" />
                    <TextBlock Style="{StaticResource Settings.RowHint}" Text="{l:T '다시 시작하면 적용됩니다. (Applies after restart.)'}" />
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource Settings.Segment}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="LanguageKorean" Style="{StaticResource Radio.Segment}" Content="한국어" GroupName="Language" />
                      <RadioButton x:Name="LanguageEnglish" Style="{StaticResource Radio.Segment}" Content="English" GroupName="Language" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Settings.Section}" Text="{l:T '파일 관리자'}" />
            <Border Style="{StaticResource Settings.Card}">
              <Grid Style="{StaticResource Settings.Row}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Style="{StaticResource Settings.RowTitle}" Text="{l:T '기본 파일 관리자로 사용'}" />
                  <TextBlock Style="{StaticResource Settings.RowHint}"
                             Text="{l:T '다른 프로그램이 폴더를 열 때와 탐색기 우클릭 &quot;새 창에서 열기&quot;를 SideBySide로 엽니다. 끄면 원래 설정(Windows 탐색기)으로 되돌립니다. Win+E와 작업 표시줄의 탐색기 아이콘은 그대로 탐색기를 엽니다.'}" />
                </StackPanel>
                <CheckBox x:Name="DefaultManager" Grid.Column="1" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <TextBlock Style="{StaticResource Settings.Section}" Text="{l:T '창 열기 단축키'}" />
            <Border Style="{StaticResource Settings.Card}">
              <StackPanel>
                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Settings.RowTitle}" Text="{l:T '단축키'}" />
                    <TextBlock Style="{StaticResource Settings.RowHint}" Text="{l:T 'SideBySide를 열거나 열려 있는 창을 앞으로 가져옵니다. 다른 프로그램이 같은 키를 쓰면 등록되지 않습니다.'}" />
                  </StackPanel>
                  <ComboBox x:Name="ShortcutBox" Grid.Column="1" Width="160" VerticalAlignment="Center">
                    <ComboBoxItem Content="Win + Alt + E" />
                    <ComboBoxItem Content="Win + Ctrl + E" />
                    <ComboBoxItem Content="Win + Shift + E" />
                  </ComboBox>
                </Grid>
                <Border Style="{StaticResource Settings.Divider}" />
                <Grid Style="{StaticResource Settings.Row}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Settings.RowTitle}" Text="{l:T 'SideBySide가 꺼져 있어도 단축키 사용'}" />
                    <TextBlock Style="{StaticResource Settings.RowHint}"
                               Text="{l:T 'Windows에 로그인하면 창 없이 백그라운드로 대기하다가, 단축키를 누르면 SideBySide를 열거나 열려 있는 창을 앞으로 가져옵니다. 끄면 앱이 실행 중일 때만 동작합니다.'}" />
                  </StackPanel>
                  <CheckBox x:Name="ShortcutWhenClosed" Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- 탐색 창 -->
        <StackPanel x:Name="SidebarPage" Visibility="Collapsed">
          <TextBlock Style="{StaticResource Settings.PageTitle}" Text="{l:T '탐색 창'}" />
          <TextBlock Style="{StaticResource Settings.Section}" Text="{l:T '빠른 실행에 표시'}" Margin="2,0,0,8" />
          <Border Style="{StaticResource Settings.Card}">
            <StackPanel x:Name="SystemPlacesPanel" />
          </Border>
          <TextBlock Style="{StaticResource Settings.RowHint}" Margin="2,8,0,0" Text="{l:T '이 위치들은 Windows 탐색기(또는 Windows 설정)로 엽니다.'}" />
        </StackPanel>

        <!-- 단축키 -->
        <DockPanel x:Name="ShortcutsPage" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock Style="{StaticResource Settings.PageTitle}" Text="{l:T '단축키'}" Margin="0" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Standard}" Content="{l:T '모두 기본값'}" Click="OnResetAll" VerticalAlignment="Center" />
          </DockPanel>

          <Border DockPanel.Dock="Bottom" Style="{StaticResource Settings.Card}" Margin="0,12,0,0" Padding="16,12">
            <StackPanel>
              <TextBlock Style="{StaticResource Settings.RowTitle}" Text="{l:T '선택한 명령의 새 단축키'}" Margin="0,0,0,8" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CaptureBox" IsReadOnly="True" PreviewKeyDown="OnCaptureKeyDown" VerticalContentAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                  <Button Style="{StaticResource Button.Primary}" Content="{l:T '지정'}" MinWidth="64" Click="OnAssign" />
                  <Button Style="{StaticResource Button.Standard}" Content="{l:T '없음'}" MinWidth="64" Margin="8,0,0,0" Click="OnClearOne" />
                  <Button Style="{StaticResource Button.Standard}" Content="{l:T '기본값'}" MinWidth="64" Margin="8,0,0,0" Click="OnResetOne" />
                </StackPanel>
              </Grid>
              <TextBlock x:Name="ShortcutHint" Style="{StaticResource Settings.RowHint}" Margin="0,8,0,0"
                         Text="{l:T '목록에서 명령을 고르고 입력란을 누른 뒤 원하는 키 조합을 누르세요. 바꾼 단축키는 확인을 누르면 바로 적용됩니다 (버튼 도움말의 표시는 다시 시작하면 바뀝니다).'}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Settings.Card}" Padding="0" ClipToBounds="True">
            <ListView x:Name="ShortcutList" Style="{StaticResource ListView.Files}" SelectionMode="Single"
                      SelectionChanged="OnShortcutSelected" BorderThickness="0" Background="Transparent">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="{l:T '명령'}" Width="270" DisplayMemberBinding="{Binding Title}" />
                  <GridViewColumn Header="{l:T '키 조합'}" Width="150" DisplayMemberBinding="{Binding Gesture}" />
                  <GridViewColumn Header="{l:T '범위'}" Width="90" DisplayMemberBinding="{Binding ScopeText}" />
                </GridView>
              </ListView.View>
            </ListView>
          </Border>
        </DockPanel>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
