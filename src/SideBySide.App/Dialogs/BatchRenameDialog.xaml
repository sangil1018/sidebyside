<Window x:Class="SideBySide.App.Dialogs.BatchRenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Dialog}" Title="여러 항목 이름 바꾸기" Width="720"
        SizeToContent="Manual" Height="580" ResizeMode="CanResize" MinHeight="420" MinWidth="560">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="20,18,20,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock Style="{StaticResource Dialog.Label}" Text="찾기" />
        <TextBox x:Name="FindBox" TextChanged="OnChanged" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Style="{StaticResource Dialog.Label}" Text="바꾸기" />
        <TextBox x:Name="ReplaceBox" TextChanged="OnChanged" />
      </StackPanel>

      <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
        <CheckBox x:Name="RegexBox" Content="정규식" Click="OnChanged" Margin="0,0,16,0" />
        <CheckBox x:Name="CaseBox" Content="대소문자 구분" Click="OnChanged" />
      </StackPanel>

      <StackPanel Grid.Row="2" Margin="0,14,0,0">
        <TextBlock Style="{StaticResource Dialog.Label}" Text="새 이름 형식" />
        <TextBox x:Name="TemplateBox" Text="{}{name}{ext}" FontFamily="{StaticResource Font.Mono}" TextChanged="OnChanged" />
      </StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,14,0,0">
        <TextBlock Style="{StaticResource Dialog.Label}" Text="시작 번호" />
        <TextBox x:Name="StartBox" Text="1" TextChanged="OnChanged" />
      </StackPanel>

      <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource Dialog.Hint}"
                 Text="{}{name} 원래 이름(찾기/바꾸기 적용 후)   {ext} 확장자(.txt)   {n} 번호   {n:3} 001처럼 자릿수 맞춤" />
    </Grid>

    <ListView x:Name="PreviewList" Grid.Row="1" Margin="20,0,20,16" Style="{StaticResource ListView.Files}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" SelectionMode="Single">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="현재 이름" Width="250">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding OriginalName}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="새 이름" Width="250">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock x:Name="NewName" Text="{Binding NewName}" TextTrimming="CharacterEllipsis" />
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter TargetName="NewName" Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Header="문제" Width="160">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.DiffError}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Error}" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
        </GridView>
      </ListView.View>
    </ListView>

    <Border Grid.Row="2" Style="{StaticResource Dialog.Footer}">
      <DockPanel>
        <TextBlock x:Name="SummaryText" Style="{StaticResource Text.Secondary}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource Button.Standard}" Content="취소" IsCancel="True" Margin="0,0,8,0" />
          <Button x:Name="ApplyButton" Style="{StaticResource Button.Primary}" Content="이름 바꾸기" IsDefault="True" Click="OnApply" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
