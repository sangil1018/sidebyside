<Window x:Class="SideBySide.App.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Dialog}" Width="420">
  <StackPanel>
    <StackPanel Margin="20,18,20,20">
      <TextBlock x:Name="LabelText" Style="{StaticResource Dialog.Label}" />
      <TextBox x:Name="Input" />
    </StackPanel>
    <Border Style="{StaticResource Dialog.Footer}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource Button.Standard}" Content="취소" IsCancel="True" Margin="0,0,8,0" />
        <Button Style="{StaticResource Button.Primary}" Content="확인" IsDefault="True" Click="OnOk" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
