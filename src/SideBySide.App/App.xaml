<Application x:Class="SideBySide.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- 첫 번째 사전은 ThemeManager가 라이트/다크로 교체한다 -->
        <ResourceDictionary Source="Themes/Tokens.Light.xaml" />
        <ResourceDictionary Source="Themes/Controls/Base.xaml" />
        <ResourceDictionary Source="Themes/Controls/Buttons.xaml" />
        <ResourceDictionary Source="Themes/Controls/Inputs.xaml" />
        <ResourceDictionary Source="Themes/Controls/ScrollBars.xaml" />
        <ResourceDictionary Source="Themes/Controls/Menus.xaml" />
        <ResourceDictionary Source="Themes/Controls/Lists.xaml" />
        <ResourceDictionary Source="Themes/Controls/Dialogs.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
