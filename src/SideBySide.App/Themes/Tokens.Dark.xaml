<!-- 색 토큰. Light/Dark 두 파일은 반드시 같은 키를 가져야 합니다. 컨트롤 스타일은 DynamicResource로만 참조합니다. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 창 바탕 (제목 표시줄·도구 모음) -->
  <SolidColorBrush x:Key="Brush.WindowBg" Color="#202020" />
  <!-- 파일 목록·편집 영역 -->
  <SolidColorBrush x:Key="Brush.SurfaceBg" Color="#272727" />
  <!-- 탐색 창 -->
  <SolidColorBrush x:Key="Brush.SidebarBg" Color="#232323" />
  <!-- 마우스 오버 -->
  <SolidColorBrush x:Key="Brush.Hover" Color="#333333" />
  <!-- 누름 -->
  <SolidColorBrush x:Key="Brush.Pressed" Color="#3A3A3A" />
  <!-- 선택 (활성 창) -->
  <SolidColorBrush x:Key="Brush.Selected" Color="#2E4057" />
  <!-- 선택 (비활성 창) -->
  <SolidColorBrush x:Key="Brush.SelectedInactive" Color="#353535" />
  <!-- 구분선 -->
  <SolidColorBrush x:Key="Brush.Border" Color="#353535" />
  <!-- 입력란 테두리 -->
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="#4A4A4A" />
  <!-- 본문 -->
  <SolidColorBrush x:Key="Brush.Text" Color="#E8E8E8" />
  <!-- 보조 텍스트 -->
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A3A3A3" />
  <!-- 비활성 -->
  <SolidColorBrush x:Key="Brush.TextDisabled" Color="#6B6B6B" />
  <!-- 강조 (포커스, 활성 탭 표시) -->
  <SolidColorBrush x:Key="Brush.Accent" Color="#6FA3DC" />
  <!-- 강조 배경 위 텍스트 -->
  <SolidColorBrush x:Key="Brush.AccentText" Color="#0F1A26" />
  <!-- 강조 옅은 배경 -->
  <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#26364A" />
  <!-- 입력란 -->
  <SolidColorBrush x:Key="Brush.InputBg" Color="#2C2C2C" />
  <!-- 닫기 버튼 오버 -->
  <SolidColorBrush x:Key="Brush.Danger" Color="#C42B1C" />
  <SolidColorBrush x:Key="Brush.DangerText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#555555" />
  <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#707070" />
  <!-- 메뉴·팝업 배경 -->
  <SolidColorBrush x:Key="Brush.Popup" Color="#2B2B2B" />
  <SolidColorBrush x:Key="Brush.Shadow" Color="#66000000" />
  <!-- 다른 항목 배경 -->
  <SolidColorBrush x:Key="Brush.DiffChanged" Color="#3B2F1F" />
  <!-- 다른 항목 표시 막대 -->
  <SolidColorBrush x:Key="Brush.DiffChangedMark" Color="#E09A4F" />
  <!-- 왼쪽에만 있음 -->
  <SolidColorBrush x:Key="Brush.DiffLeft" Color="#1F2D3E" />
  <SolidColorBrush x:Key="Brush.DiffLeftMark" Color="#6FA3DC" />
  <!-- 오른쪽에만 있음 -->
  <SolidColorBrush x:Key="Brush.DiffRight" Color="#1F3326" />
  <SolidColorBrush x:Key="Brush.DiffRightMark" Color="#6CC08B" />
  <!-- 줄 안에서 바뀐 글자 (왼쪽) -->
  <SolidColorBrush x:Key="Brush.DiffCharLeft" Color="#6B4A2A" />
  <!-- 줄 안에서 바뀐 글자 (오른쪽) -->
  <SolidColorBrush x:Key="Brush.DiffCharRight" Color="#6B4A2A" />
  <!-- 반대쪽에만 있는 행의 빈 자리 -->
  <SolidColorBrush x:Key="Brush.DiffPlaceholder" Color="#232323" />
  <SolidColorBrush x:Key="Brush.DiffError" Color="#F1707B" />
  <!-- 더 최신 파일 표시 점 -->
  <SolidColorBrush x:Key="Brush.Newer" Color="#6FA3DC" />

  <!-- 기본 WPF 템플릿(스크롤 모서리, 메시지 상자 외 컨트롤)이 쓰는 시스템 색을 테마에 맞춤 -->
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#272727" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#272727" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E8E8E8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8E8E8" />
</ResourceDictionary>
