<!-- 간격·크기 토큰. 모듈 화면과 도구 패널은 숫자를 직접 쓰지 않고 이 값을 쓴다 (화면 사이 여백·높이 통일). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <sys:Double x:Key="Space.XS">4</sys:Double>
  <sys:Double x:Key="Space.S">8</sys:Double>
  <sys:Double x:Key="Space.M">12</sys:Double>
  <sys:Double x:Key="Space.L">16</sys:Double>

  <!-- 패널 안쪽 여백 (머리글·본문·버튼 줄이 같은 좌우 여백) -->
  <Thickness x:Key="Panel.Padding">16,0,16,0</Thickness>
  <Thickness x:Key="Panel.HeaderPadding">16,14,10,12</Thickness>
  <Thickness x:Key="Panel.FooterPadding">16,10,16,10</Thickness>
  <!-- 묶음(카드) 사이 간격과 카드 안 행 여백 -->
  <Thickness x:Key="Section.Margin">0,0,0,14</Thickness>
  <Thickness x:Key="Row.Padding">12,8,12,8</Thickness>
  <!-- 아이콘과 글자 사이 -->
  <Thickness x:Key="Icon.Gap">0,0,6,0</Thickness>

  <sys:Double x:Key="Control.Height">30</sys:Double>
  <sys:Double x:Key="Panel.TabHeight">34</sys:Double>
  <CornerRadius x:Key="Radius.Card">6</CornerRadius>
</ResourceDictionary>
