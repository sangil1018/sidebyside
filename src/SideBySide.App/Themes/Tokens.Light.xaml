<!-- 색 토큰. Light/Dark 두 파일은 반드시 같은 키를 가져야 합니다. 컨트롤 스타일은 DynamicResource로만 참조합니다. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 창 바탕 (제목 표시줄·도구 모음) -->
  <SolidColorBrush x:Key="Brush.WindowBg" Color="#F3F3F3" />
  <!-- 파일 목록·편집 영역 -->
  <SolidColorBrush x:Key="Brush.SurfaceBg" Color="#FFFFFF" />
  <!-- 탐색 창 -->
  <SolidColorBrush x:Key="Brush.SidebarBg" Color="#F7F7F7" />
  <!-- 마우스 오버 -->
  <SolidColorBrush x:Key="Brush.Hover" Color="#EAEAEA" />
  <!-- 누름 -->
  <SolidColorBrush x:Key="Brush.Pressed" Color="#DEDEDE" />
  <!-- 선택 (활성 창) -->
  <SolidColorBrush x:Key="Brush.Selected" Color="#DCE8F5" />
  <!-- 선택 (비활성 창) -->
  <SolidColorBrush x:Key="Brush.SelectedInactive" Color="#E8E8E8" />
  <!-- 구분선 -->
  <SolidColorBrush x:Key="Brush.Border" Color="#E3E3E3" />
  <!-- 입력란 테두리 -->
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="#CFCFCF" />
  <!-- 본문 -->
  <SolidColorBrush x:Key="Brush.Text" Color="#1A1A1A" />
  <!-- 보조 텍스트 -->
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#666666" />
  <!-- 비활성 -->
  <SolidColorBrush x:Key="Brush.TextDisabled" Color="#A0A0A0" />
  <!-- 강조 (포커스, 활성 탭 표시) -->
  <SolidColorBrush x:Key="Brush.Accent" Color="#2F6DB5" />
  <!-- 강조 배경 위 텍스트 -->
  <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" />
  <!-- 강조 옅은 배경 -->
  <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#E6EEF8" />
  <!-- 입력란 -->
  <SolidColorBrush x:Key="Brush.InputBg" Color="#FFFFFF" />
  <!-- 닫기 버튼 오버 -->
  <SolidColorBrush x:Key="Brush.Danger" Color="#C42B1C" />
  <SolidColorBrush x:Key="Brush.DangerText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#C2C2C2" />
  <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#9E9E9E" />
  <!-- 메뉴·팝업 배경 -->
  <SolidColorBrush x:Key="Brush.Popup" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Shadow" Color="#22000000" />
  <!-- 다른 항목 배경 -->
  <SolidColorBrush x:Key="Brush.DiffChanged" Color="#FFF3E2" />
  <!-- 다른 항목 표시 막대 -->
  <SolidColorBrush x:Key="Brush.DiffChangedMark" Color="#D9822B" />
  <!-- 왼쪽에만 있음 -->
  <SolidColorBrush x:Key="Brush.DiffLeft" Color="#E7F0FA" />
  <SolidColorBrush x:Key="Brush.DiffLeftMark" Color="#2F6DB5" />
  <!-- 오른쪽에만 있음 -->
  <SolidColorBrush x:Key="Brush.DiffRight" Color="#E6F4EA" />
  <SolidColorBrush x:Key="Brush.DiffRightMark" Color="#2E8B57" />
  <!-- 줄 안에서 바뀐 글자 (왼쪽) -->
  <SolidColorBrush x:Key="Brush.DiffCharLeft" Color="#F6C9A0" />
  <!-- 줄 안에서 바뀐 글자 (오른쪽) -->
  <SolidColorBrush x:Key="Brush.DiffCharRight" Color="#F6C9A0" />
  <!-- 반대쪽에만 있는 행의 빈 자리 -->
  <SolidColorBrush x:Key="Brush.DiffPlaceholder" Color="#F6F6F6" />
  <SolidColorBrush x:Key="Brush.DiffError" Color="#C42B1C" />
  <!-- 더 최신 파일 표시 점 -->
  <SolidColorBrush x:Key="Brush.Newer" Color="#2F6DB5" />

  <!-- 기본 WPF 템플릿(스크롤 모서리, 메시지 상자 외 컨트롤)이 쓰는 시스템 색을 테마에 맞춤 -->
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#1A1A1A" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#1A1A1A" />
</ResourceDictionary>
