<!-- 모듈 화면 공통 골격(SideBySide.Modules.ToolPanel / ToolSection / ToolRow)과 모듈이 쓰는 기본 컨트롤 모양. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="clr-namespace:SideBySide.Modules;assembly=SideBySide.Modules.Abstractions">

  <Style TargetType="m:ToolPanel">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceBg}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="m:ToolPanel">
          <Grid Background="{TemplateBinding Background}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 머리글: 아이콘 · 제목/설명 · 작은 도구 -->
            <Grid Margin="{StaticResource Panel.HeaderPadding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="32" Height="32" CornerRadius="{StaticResource Radius.Card}" Background="{DynamicResource Brush.AccentSubtle}"
                      Margin="0,0,12,0" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource Glyph}" Text="{TemplateBinding Glyph}" FontSize="16" Foreground="{DynamicResource Brush.Accent}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{TemplateBinding Subtitle}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{TemplateBinding Subtitle}" />
              </StackPanel>
              <ContentPresenter Grid.Column="2" Content="{TemplateBinding HeaderTools}" VerticalAlignment="Center" />
            </Grid>

            <!-- 본문: 기본은 스크롤. ScrollContent=False면 PlainContent로 옮긴다 (두 ContentPresenter가 같은 내용을 동시에 갖지 않게) -->
            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="{StaticResource Panel.Padding}" Focusable="False">
              <ContentPresenter x:Name="ScrolledContent" Content="{TemplateBinding Content}" />
            </ScrollViewer>
            <ContentPresenter x:Name="PlainContent" Grid.Row="1" Margin="{StaticResource Panel.Padding}" Visibility="Collapsed" Content="{x:Null}" />

            <!-- 진행 행: 앱 하단 작업 진행 행과 같은 모양 -->
            <Grid x:Name="ProgressRow" Grid.Row="2" Visibility="Collapsed" ClipToBounds="True" Height="30">
              <Grid x:Name="Fill" HorizontalAlignment="Left">
                <Grid.Width>
                  <MultiBinding Converter="{StaticResource RatioToWidth}">
                    <Binding Path="Progress" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="ActualWidth" ElementName="ProgressRow" />
                  </MultiBinding>
                </Grid.Width>
                <Rectangle Fill="{DynamicResource Brush.Accent}" Opacity="0.22" />
                <Rectangle Width="2" HorizontalAlignment="Right" Fill="{DynamicResource Brush.Accent}" />
              </Grid>
              <Border x:Name="Runner" Width="160" HorizontalAlignment="Left" Visibility="Collapsed"
                      Background="{DynamicResource Brush.Accent}" Opacity="0.22">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="RunnerShift" X="-160" />
                </Border.RenderTransform>
              </Border>
              <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
              <TextBlock Text="{TemplateBinding Status}" Margin="16,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- 아래 버튼 줄 -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                    Padding="{StaticResource Panel.FooterPadding}" Background="{DynamicResource Brush.WindowBg}">
              <DockPanel>
                <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Footer}" />
                <TextBlock x:Name="FooterStatus" Text="{TemplateBinding Status}" Style="{StaticResource Text.Secondary}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{TemplateBinding Status}" />
              </DockPanel>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ScrollContent" Value="False">
              <Setter TargetName="Scroller" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="ScrolledContent" Property="Content" Value="{x:Null}" />
              <Setter TargetName="PlainContent" Property="Visibility" Value="Visible" />
              <Setter TargetName="PlainContent" Property="Content" Value="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsBusy" Value="True">
              <Setter TargetName="ProgressRow" Property="Visibility" Value="Visible" />
              <Setter TargetName="FooterStatus" Property="Visibility" Value="Hidden" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsBusy" Value="True" />
                <Condition Property="Progress" Value="NaN" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Fill" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Runner" Property="Visibility" Value="Visible" />
              <MultiTrigger.EnterActions>
                <BeginStoryboard x:Name="RunStory">
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="RunnerShift" Storyboard.TargetProperty="X" From="-160" To="1200" Duration="0:0:1.8" />
                  </Storyboard>
                </BeginStoryboard>
              </MultiTrigger.EnterActions>
              <MultiTrigger.ExitActions>
                <StopStoryboard BeginStoryboardName="RunStory" />
              </MultiTrigger.ExitActions>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="m:ToolSection">
    <Setter Property="Margin" Value="{StaticResource Section.Margin}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="m:ToolSection">
          <StackPanel>
            <TextBlock x:Name="Head" Text="{TemplateBinding Header}" FontWeight="SemiBold" Margin="2,0,0,6" />
            <Border Background="{DynamicResource Brush.WindowBg}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}" Padding="0,4">
              <ContentPresenter />
            </Border>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Header" Value="{x:Null}">
              <Setter TargetName="Head" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="m:ToolRow">
    <Setter Property="Padding" Value="{StaticResource Row.Padding}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="m:ToolRow">
          <Grid Margin="{TemplateBinding Padding}" MinHeight="{StaticResource Control.Height}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="80" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="{TemplateBinding Label}" TextWrapping="Wrap" />
              <TextBlock x:Name="HintText" Text="{TemplateBinding Hint}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Hint" Value="{x:Null}">
              <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 슬라이더: 얇은 트랙 + 강조색 원형 손잡이 -->
  <Style x:Key="Slider.Thumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{DynamicResource Brush.Accent}"
                   Stroke="{DynamicResource Brush.SurfaceBg}" StrokeThickness="2" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Knob" Property="Width" Value="16" />
              <Setter TargetName="Knob" Property="Height" Value="16" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Slider.Fill" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Slider">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Track x:Name="PART_Track" VerticalAlignment="Center">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource Slider.Fill}" Background="{DynamicResource Brush.Accent}" Command="Slider.DecreaseLarge" />
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource Slider.Fill}" Background="{DynamicResource Brush.BorderStrong}" Command="Slider.IncreaseLarge" />
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
              <Thumb Style="{StaticResource Slider.Thumb}" />
            </Track.Thumb>
          </Track>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 도구 패널 위쪽 탭 (열린 도구 전환) -->
  <Style x:Key="ToolTab" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Border x:Name="Bd" Padding="10,0,4,0" Background="Transparent">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <Rectangle x:Name="Bar" Height="2" VerticalAlignment="Bottom" Margin="8,0" Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
              <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
