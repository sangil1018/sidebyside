<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:infra="clr-namespace:SideBySide.App.Infrastructure">

  <!-- 글꼴: 시스템 글꼴만 사용 (추가 용량 없음). Windows 10은 대체 글꼴로 표시된다. -->
  <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, D2Coding, Malgun Gothic</FontFamily>
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <sys:Double x:Key="FontSize.Body">13</sys:Double>
  <sys:Double x:Key="FontSize.Small">12</sys:Double>
  <sys:Double x:Key="FontSize.Icon">14</sys:Double>
  <sys:Double x:Key="RowHeight">26</sys:Double>
  <CornerRadius x:Key="Radius">4</CornerRadius>

  <!-- 변환기 -->
  <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
  <infra:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
  <infra:NullToVisibilityConverter x:Key="NullToVis" />
  <infra:NullToVisibilityConverter x:Key="NullToVisInv" Invert="True" />
  <infra:InverseBoolConverter x:Key="InverseBool" />
  <infra:EnumEqualsConverter x:Key="EnumEquals" />
  <infra:RatioToWidthConverter x:Key="RatioToWidth" />

  <!-- 아이콘 글리프 텍스트 -->
  <Style x:Key="Glyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Icon}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Text.Secondary" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Text.SectionHeader" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    <Setter Property="Margin" Value="12,12,0,4" />
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.BorderStrong}"
                  BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="8,4">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Splitter" TargetType="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
    <Setter Property="Width" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
    <Setter Property="Template">
      <Setter.Value>
        <!-- 1px로 보이지만 잡기 쉽게 투명 여백 포함 -->
        <ControlTemplate TargetType="GridSplitter">
          <Grid Background="Transparent" Margin="-3,0">
            <Rectangle Fill="{TemplateBinding Background}" Width="1" HorizontalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
