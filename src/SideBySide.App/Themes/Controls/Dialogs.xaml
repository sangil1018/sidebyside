<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- WindowStartupLocation은 의존 속성이 아니라 스타일로 지정할 수 없음 → DialogService가 설정 -->
  <Style x:Key="Window.Dialog" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Brush.WindowBg}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="ResizeMode" Value="NoResize" />
    <Setter Property="SizeToContent" Value="Height" />
    <Setter Property="ShowInTaskbar" Value="False" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style x:Key="Dialog.Footer" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="20,12" />
  </Style>

  <Style x:Key="Dialog.Label" TargetType="TextBlock">
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

  <Style x:Key="Dialog.Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
    <Setter Property="Margin" Value="0,5,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

</ResourceDictionary>
