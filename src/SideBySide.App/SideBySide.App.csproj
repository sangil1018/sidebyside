<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>SideBySide</AssemblyName>
    <RootNamespace>SideBySide.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <TieredPGO>true</TieredPGO>
    <!-- 시작 속도: publish 시 ReadyToRun(build.ps1에서 지정) -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SideBySide.Core\SideBySide.Core.csproj" />
    <ProjectReference Include="..\SideBySide.Shell\SideBySide.Shell.csproj" />
    <ProjectReference Include="..\SideBySide.Modules.Abstractions\SideBySide.Modules.Abstractions.csproj" />
    <!-- 모듈은 실행 파일에 함께 들어가지만, 처음 열 때까지 로드되지 않는다 (Modules/ModuleCatalog.cs) -->
    <ProjectReference Include="..\Modules\SideBySide.Modules.Resize\SideBySide.Modules.Resize.csproj" />
    <ProjectReference Include="..\Modules\SideBySide.Modules.SeqRenumber\SideBySide.Modules.SeqRenumber.csproj" />
    <ProjectReference Include="..\Modules\SideBySide.Modules.SeqViewer\SideBySide.Modules.SeqViewer.csproj" />
    <ProjectReference Include="..\Modules\SideBySide.Modules.TempCleaner\SideBySide.Modules.TempCleaner.csproj" />
    <ProjectReference Include="..\Modules\SideBySide.Modules.LanShare\SideBySide.Modules.LanShare.csproj" />
    <ProjectReference Include="..\Modules\SideBySide.Modules.DirectConnect\SideBySide.Modules.DirectConnect.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SideBySide.Modules.Tests" />
  </ItemGroup>

</Project>
