<Window x:Class="SideBySide.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SideBySide.App.Infrastructure"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cmd="clr-namespace:SideBySide.App.Commands"
        xmlns:vm="clr-namespace:SideBySide.App.ViewModels"
        xmlns:views="clr-namespace:SideBySide.App.Views"
        xmlns:compare="clr-namespace:SideBySide.Core.Compare;assembly=SideBySide.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Icon="Assets/app.ico"
        Width="1280" Height="800" MinWidth="720" MinHeight="420"
        Background="{DynamicResource Brush.WindowBg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}"
        FontSize="{StaticResource FontSize.Body}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Window.TaskbarItemInfo>
    <TaskbarItemInfo ProgressState="{Binding TaskbarState}" ProgressValue="{Binding TaskbarProgress}" />
  </Window.TaskbarItemInfo>

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                  CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Border x:Name="RootBorder">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="26" />
      </Grid.RowDefinitions>

      <!-- ── 제목 표시줄 ─────────────────────────────────────────── -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Margin="14,0,16,0" VerticalAlignment="Center">
          <!-- 앱 아이콘(Assets/app.ico)과 같은 모양의 벡터 로고: 작은 크기에서도 선명 -->
          <Border Width="16" Height="16" CornerRadius="4" Background="#2F6DB5" Margin="0,0,10,0" VerticalAlignment="Center">
            <Grid Margin="3,3.5">
              <Rectangle Width="4.5" HorizontalAlignment="Left" Fill="White" RadiusX="1" RadiusY="1" />
              <Rectangle Width="4.5" HorizontalAlignment="Right" Fill="White" RadiusX="1" RadiusY="1" />
            </Grid>
          </Border>
          <TextBlock Text="SideBySide" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.TextSecondary}" />
        </StackPanel>

        <!-- 한 창 | 두 창 (분할) + 비교 켜기/끄기 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True">
          <Border Background="{DynamicResource Brush.Hover}" CornerRadius="5" Padding="2"
                  ToolTip="{cmd:Tip ToggleDualPane}">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource Radio.Segment}" Content="{l:T '한 창'}" GroupName="Panes"
                           IsChecked="{Binding IsDualPane, Converter={StaticResource InverseBool}}" />
              <RadioButton Style="{StaticResource Radio.Segment}" Content="{l:T '두 창'}" GroupName="Panes"
                           IsChecked="{Binding IsDualPane}" />
            </StackPanel>
          </Border>
          <ToggleButton Style="{StaticResource Button.Ghost}" Margin="6,0,0,0" Content="{l:T '비교'}"
                        IsChecked="{Binding IsCompareMode, Mode=OneWay}"
                        Command="{cmd:Command ToggleCompare}" ToolTip="{cmd:Tip ToggleCompare}" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,8,0">
          <Button Style="{StaticResource Button.Icon}" Content="&#xE7C3;" Command="{cmd:Command OpenSession}" ToolTip="{cmd:Tip OpenSession}" />
          <Button Style="{StaticResource Button.Icon}" Content="&#xE713;" Command="{cmd:Command OpenSettings}" ToolTip="{cmd:Tip OpenSettings}" />
          <Button Style="{StaticResource Button.Icon}" Content="&#xE793;" Command="{cmd:Command ToggleTheme}" ToolTip="{cmd:Tip ToggleTheme}" />
        </StackPanel>

        <StackPanel Grid.Column="4" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" Click="OnMinimize" ToolTip="{l:T '최소화'}" />
          <Button x:Name="MaxButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" Click="OnMaximize" ToolTip="{l:T '최대화'}" />
          <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" Click="OnClose" ToolTip="{l:T '닫기'}" />
        </StackPanel>
      </Grid>

      <!-- ── 도구 모음 ───────────────────────────────────────────── -->
      <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,4">
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
            <Button x:Name="NewButton" Style="{StaticResource Button.Ghost}" Click="OnNewMenu" ToolTip="{l:T '새로 만들기'}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Margin="0,0,6,0" />
                <TextBlock Text="{l:T '새로 만들기'}" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="9" Margin="6,0,0,0" />
              </StackPanel>
            </Button>
            <Rectangle Width="1" Margin="6,6" Fill="{DynamicResource Brush.Border}" />
            <Button Style="{StaticResource Button.Icon}" Content="&#xE8C6;" Command="{cmd:Command Cut}" ToolTip="{cmd:Tip Cut}" />
            <Button Style="{StaticResource Button.Icon}" Content="&#xE8C8;" Command="{cmd:Command Copy}" ToolTip="{cmd:Tip Copy}" />
            <Button Style="{StaticResource Button.Icon}" Content="&#xE77F;" Command="{cmd:Command Paste}" ToolTip="{cmd:Tip Paste}" />
            <Button Style="{StaticResource Button.Icon}" Content="&#xE8AC;" Command="{cmd:Command Rename}" ToolTip="{cmd:Tip Rename}" />
            <Button Style="{StaticResource Button.Icon}" Content="&#xE74D;" Command="{cmd:Command Delete}" ToolTip="{cmd:Tip Delete}" />
            <Button Style="{StaticResource Button.Icon}" Content="&#xE7A7;" Command="{cmd:Command Undo}" ToolTip="{cmd:Tip Undo}" />
            <Rectangle Width="1" Margin="6,6" Fill="{DynamicResource Brush.Border}" />
            <Button Style="{StaticResource Button.Icon}" Content="&#xE946;" Command="{cmd:Command Properties}" ToolTip="{cmd:Tip Properties}" />
            <Button Style="{StaticResource Button.Icon}" Content="&#xE756;" Command="{cmd:Command OpenTerminal}" ToolTip="{cmd:Tip OpenTerminal}" />
            <Button Style="{StaticResource Button.Icon}" Content="&#xE718;" Command="{cmd:Command PinFavorite}" ToolTip="{cmd:Tip PinFavorite}" />

            <!-- 두 창: 반대쪽 창으로 복사/이동 -->
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsDualPane, Converter={StaticResource BoolToVis}}">
              <Rectangle Width="1" Margin="6,6" Fill="{DynamicResource Brush.Border}" />
              <Button Style="{StaticResource Button.Ghost}" Command="{cmd:Command CopyToRight}" ToolTip="{cmd:Tip CopyToRight}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{l:T '복사'}" Margin="0,0,6,0" />
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE72A;" FontSize="12" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource Button.Ghost}" Command="{cmd:Command CopyToLeft}" ToolTip="{cmd:Tip CopyToLeft}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" FontSize="12" Margin="0,0,6,0" />
                  <TextBlock Text="{l:T '복사'}" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource Button.Ghost}" Command="{cmd:Command MoveToRight}" ToolTip="{cmd:Tip MoveToRight}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{l:T '이동'}" Margin="0,0,6,0" />
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE72A;" FontSize="12" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource Button.Ghost}" Command="{cmd:Command MoveToLeft}" ToolTip="{cmd:Tip MoveToLeft}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" FontSize="12" Margin="0,0,6,0" />
                  <TextBlock Text="{l:T '이동'}" />
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- 비교 모드 도구 -->
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVis}}">
              <Rectangle Width="1" Margin="6,6" Fill="{DynamicResource Brush.Border}" />
              <ComboBox Width="118" Margin="2,0" VerticalAlignment="Center" ToolTip="{l:T '비교 기준'}"
                        ItemsSource="{Binding Source={x:Static vm:CompareViewModel.Methods}}"
                        SelectedItem="{Binding Compare.Method}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock x:Name="T" Text="{l:T '크기·날짜'}" />
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding}" Value="{x:Static compare:CompareMethod.Content}">
                        <Setter TargetName="T" Property="Text" Value="{l:T '내용 (바이트)'}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ToggleButton Style="{StaticResource Button.Ghost}" IsChecked="{Binding Compare.ShowDifferencesOnly}"
                            ToolTip="{cmd:Tip ToggleDifferencesOnly}" Margin="2,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" Margin="0,0,6,0" />
                  <TextBlock Text="{l:T '차이만'}" />
                </StackPanel>
              </ToggleButton>
              <Button Style="{StaticResource Button.Icon}" Content="&#xE74B;" Command="{cmd:Command NextDifference}" ToolTip="{cmd:Tip NextDifference}" />
              <Button Style="{StaticResource Button.Icon}" Content="&#xE74A;" Command="{cmd:Command PrevDifference}" ToolTip="{cmd:Tip PrevDifference}" />
              <ToggleButton x:Name="CompareOptionsButton" Style="{StaticResource Button.Icon}" Content="&#xE713;" ToolTip="{l:T '비교 옵션'}" />
              <Popup PlacementTarget="{Binding ElementName=CompareOptionsButton}" Placement="Bottom" StaysOpen="False"
                     AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=CompareOptionsButton}">
                <Border Background="{DynamicResource Brush.Popup}" BorderBrush="{DynamicResource Brush.BorderStrong}"
                        BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,4,0,0" Width="280">
                  <StackPanel>
                    <TextBlock Text="{l:T '비교 옵션'}" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <CheckBox Content="{l:T '하위 폴더 내용까지 비교'}" IsChecked="{Binding Compare.CompareSubfolders}" Margin="0,0,0,8" />
                    <DockPanel Margin="0,0,0,8">
                      <TextBlock Text="{l:T '초'}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0" />
                      <TextBox DockPanel.Dock="Right" Width="48" Text="{Binding Compare.TimeToleranceSeconds, UpdateSourceTrigger=LostFocus}" />
                      <TextBlock Text="{l:T '수정 시각 허용 오차'}" VerticalAlignment="Center" />
                    </DockPanel>
                    <CheckBox Content="{l:T '정확히 1시간 차이는 같게 보기 (서머타임)'}" IsChecked="{Binding Compare.IgnoreHourOffset}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="{l:T 'FAT/exFAT·네트워크 드라이브는 시각을 2초 단위로 저장하므로 2초 이상을 권장합니다.'}" />
                  </StackPanel>
                </Border>
              </Popup>
              <Button Style="{StaticResource Button.Icon}" Content="&#xE74E;" Command="{cmd:Command SaveSession}" ToolTip="{cmd:Tip SaveSession}" />
            </StackPanel>
          </StackPanel>

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <!-- 활성 필터 칩 -->
            <Border Background="{DynamicResource Brush.AccentSubtle}" CornerRadius="12" Padding="10,2,4,2" Margin="0,0,6,0"
                    VerticalAlignment="Center" MaxWidth="360"
                    Visibility="{Binding FilterSummary, Converter={StaticResource NullToVis}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" FontSize="11" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding FilterSummary}" TextTrimming="CharacterEllipsis" MaxWidth="280" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text}" FontSize="{StaticResource FontSize.Small}"
                           ToolTip="{Binding FilterSummary}" />
                <Button Style="{StaticResource Button.SmallIcon}" Content="&#xE711;" Margin="4,0,0,0"
                        Command="{cmd:Command ClearFilter}" ToolTip="{cmd:Tip ClearFilter}" />
              </StackPanel>
            </Border>
            <Button Style="{StaticResource Button.Ghost}" Command="{cmd:Command EditFilter}" ToolTip="{cmd:Tip EditFilter}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;" Margin="0,0,6,0" />
                <TextBlock Text="{l:T '필터'}" />
              </StackPanel>
            </Button>
            <Rectangle Width="1" Margin="6,6" Fill="{DynamicResource Brush.Border}" />
            <Button x:Name="ViewButton" Style="{StaticResource Button.Ghost}" Click="OnViewMenu" ToolTip="{l:T '보기 방식 (Ctrl+마우스 휠)'}"
                    IsEnabled="{Binding IsCompareMode, Converter={StaticResource InverseBool}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" Margin="0,0,6,0" />
                <TextBlock Text="{l:T '보기'}" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="9" Margin="6,0,0,0" />
              </StackPanel>
            </Button>
            <ToggleButton Style="{StaticResource Button.Ghost}" Content="{l:T '탐색 창'}" IsChecked="{Binding ShowSidebar}" ToolTip="{cmd:Tip ToggleSidebar}" />
            <ToggleButton Style="{StaticResource Button.Ghost}" Content="{l:T '미리보기'}" IsChecked="{Binding ShowPreview}" ToolTip="{cmd:Tip TogglePreview}" />
            <ToggleButton Style="{StaticResource Button.Ghost}" Content="{l:T '숨김 항목'}" IsChecked="{Binding ShowHidden}" ToolTip="{cmd:Tip ToggleHidden}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ── 본문 ───────────────────────────────────────────────── -->
      <Grid Grid.Row="2" x:Name="ContentGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SidebarColumn" Width="210" MinWidth="0" MaxWidth="480" />
          <ColumnDefinition x:Name="SidebarSplitColumn" Width="Auto" />
          <ColumnDefinition x:Name="LeftColumn" Width="*" MinWidth="240" />
          <ColumnDefinition x:Name="PaneSplitColumn" Width="Auto" />
          <ColumnDefinition x:Name="RightColumn" Width="*" />
          <ColumnDefinition x:Name="PreviewSplitColumn" Width="Auto" />
          <ColumnDefinition x:Name="PreviewColumn" Width="0" MaxWidth="900" />
        </Grid.ColumnDefinitions>

        <views:NavigationSidebar Grid.Column="0" DataContext="{Binding}" />
        <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Style="{StaticResource Splitter}" />

        <views:FilePane x:Name="LeftPane" Grid.Column="2" DataContext="{Binding Left}" />
        <GridSplitter x:Name="PaneSplitter" Grid.Column="3" Style="{StaticResource Splitter}" />
        <views:FilePane x:Name="RightPane" Grid.Column="4" DataContext="{Binding Right}" />

        <GridSplitter x:Name="PreviewSplitter" Grid.Column="5" Style="{StaticResource Splitter}" />
        <views:PreviewPane x:Name="PreviewPane" Grid.Column="6" DataContext="{Binding Preview}" />

        <!-- 파일 비교 화면: 창 영역 위에 덮어 표시 -->
        <views:FileDiffView x:Name="DiffView" Grid.Column="2" Grid.ColumnSpan="3"
                            DataContext="{Binding ActiveDiff}"
                            Visibility="{Binding DataContext.IsDiffOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
      </Grid>

      <!-- ── 진행 중인 파일 작업 (별도 창 없이 하단에 표시) ─────────── -->
      <ItemsControl Grid.Row="3" ItemsSource="{Binding Operations}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:OperationViewModel}">
            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,6,6,6"
                    Background="{DynamicResource Brush.SurfaceBg}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="220" />
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="  " />
                    <Run Text="{Binding CurrentItem, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}" />
                  </TextBlock>
                  <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ProgressBar Grid.Column="1" Style="{StaticResource ProgressBar.Thin}" VerticalAlignment="Center"
                             Value="{Binding Fraction, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" />
                <TextBlock Grid.Column="2" Style="{StaticResource Text.Secondary}" Text="{Binding PercentText}"
                           HorizontalAlignment="Right" />
                <Button Grid.Column="3" Style="{StaticResource Button.SmallIcon}" Content="&#xE711;" Margin="8,0,0,0"
                        Command="{Binding CancelCommand}" ToolTip="{l:T '작업 취소'}"
                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ── 상태 표시줄 ─────────────────────────────────────────── -->
      <Border Grid.Row="4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Secondary}" Text="{Binding FreeSpaceText}" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding StatusText}" />
            <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding SelectionText}" Margin="16,0,0,0" />
            <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding HiddenText}" Margin="16,0,0,0" />
            <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Notice}" Margin="16,0,0,0"
                       Foreground="{DynamicResource Brush.Accent}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
